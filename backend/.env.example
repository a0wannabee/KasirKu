# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Terminate TLS with a reverse proxy (nginx/Caddy) in production; app must only be
# reachable over HTTPS externally.

# --- Database ---
DATABASE_URL="postgresql://pos_user:CHANGE_ME@localhost:5432/pos_inventory?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="replace_with_long_random_secret_never_commit"
JWT_REFRESH_SECRET="replace_with_another_long_random_secret"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Login throttling ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- File storage (nota / receipt photos) ---
UPLOAD_DIR=./storage/receipts
MAX_UPLOAD_MB=8

# --- OCR / AI extraction provider ---
# Any provider can be plugged in via src/services/ocrService.js
OCR_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace_me
OCR_PROVIDER_TESSERACT_LANG=ind+eng

# --- Backup ---
BACKUP_DIR=./storage/backups
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30
